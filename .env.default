# JetBrains Marketplace publishing credentials for `just publish-jetbrains`.
# Copy to .env (gitignored) and fill in:  cp .env.default .env

# Permanent upload token for the JetBrains Marketplace.
# Generate at: https://plugins.jetbrains.com/author/me/tokens
PUBLISH_TOKEN=

# Passphrase for creds/private.pem.
#
# Signing keys live in creds/ (gitignored). The recipe reads
# creds/private.pem and creds/chain.crt directly. To (re)generate:
#
#   mkdir -p creds && cd creds
#   openssl genpkey -aes-256-cbc -algorithm RSA -out private_encrypted.pem \
#       -pkeyopt rsa_keygen_bits:4096
#   openssl rsa -in private_encrypted.pem -out private.pem
#   openssl req -key private.pem -new -x509 -days 365 -out chain.crt \
#       -subj "/CN=Nils Loewen/emailAddress=nils@nilsloewen.com"
#
# Docs: https://plugins.jetbrains.com/docs/intellij/plugin-signing.html
PRIVATE_KEY_PASSWORD=
